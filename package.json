{
  "name": "repository-decision-helper",
  "version": "1.0.0",
  "description": "Web application that guides developers through repository decision-making and automates setup with best practices",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "repository",
    "monorepo",
    "github",
    "automation",
    "best-practices"
  ],
  "author": "gupta-kartik",
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "aws-sdk": "^2.1692.0",
    "concurrently": "^9.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "nodemon": "^3.1.10"
  }
}
